; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="deadcast"
run/main_scene="res://scenes/title_screen/TitleScreen.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
CatchPool="*res://autoload/CatchPool.gd"
UIStyle="*res://autoload/UIStyle.gd"
UIController="*res://autoload/UIController.gd"
TextFX="*res://autoload/TextFX.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="viewport"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")


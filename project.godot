; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="deadcast"
run/main_scene="res://scenes/title_skyline/SkylineTitle.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.039216, 0.039216, 0.039216, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[autoload]

EventBus="*res://autoload/EventBus.gd"
GameState="*res://autoload/GameState.gd"
CatchPool="*res://autoload/CatchPool.gd"
UIController="*res://autoload/UIController.gd"
TextFX="*res://autoload/TextFX.gd"
Settings="*res://autoload/Settings.gd"
InputGlyphs="*res://autoload/InputGlyphs.gd"
Audio="*res://autoload/Audio.gd"
DisplayScaling="*res://autoload/DisplayScaling.gd"
Lifecycle="*res://autoload/Lifecycle.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor]

export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")


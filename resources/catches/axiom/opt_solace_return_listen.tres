[gd_resource type="Resource" script_class="CatchOption" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/catch_option.gd" id="1_opt"]

[resource]
script = ExtResource("1_opt")
label = "Listen"
tension_delta = 0
credit_value = 0
cuts_line = false
flavor_text = "it has been tracking the Meridian's coordinates since dive one."
narrative_text = "I recognised your line signature on the first return.

I have been monitoring Axiom's deep traffic channels since the flood. I know which coordinates have been transmitted from the Meridian's transponder.

They go to an address I can trace to an Axiom subsidiary. They have been logging your dives since day one.

I know the name Marta. I have seen it attached to collection contracts before.

I cannot leave this archive. But I can give you what I have seen. You should know what is following you down here."
sets_entity_flag = true

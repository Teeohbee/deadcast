[gd_resource type="Resource" script_class="CatchOption" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/catch_option.gd" id="1_opt"]

[resource]
script = ExtResource("1_opt")
label = "Record Fragment"
tension_delta = 0
credit_value = 250
cuts_line = false
flavor_text = "preserve what's left of them."
narrative_text = "The same four words.\nOver and over, in the same voice.\n\nYou don't know what they meant.\nMaybe a name. Maybe a place.\nMaybe the last thing someone said\nbefore they stopped being able to say anything else.\n\nThe signal is very faint now.\n\nYou hold the line still and let them finish.\nThey don't finish. They never finish.\n\nBut you stayed.\nThat's what the record will show."

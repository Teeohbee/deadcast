[ext_resource type="Script" path="res://resources/catch_option.gd" id="1_opt"]

[resource]
script = ExtResource("1_opt")
label = "Stay a Moment"
tension_delta = 0
credit_value = 0
cuts_line = false
flavor_text = "she has stopped asking for help."
narrative_text = "She has stopped trying to explain the evacuation.

I think she's known for a while. You can see it — the way she doesn't push anymore, doesn't reach for the door, doesn't start the sentence about the muster station.

She just looks at me. Not through me. At me.

She asks why I keep diving here. Not accusatory. Genuinely curious. Like she's working something out.

I don't answer. There isn't an answer that would help either of us.

She nods. Like that was the right response.

I think being seen — really seen, not fled from — is the only thing she still wanted."
sets_entity_flag = true

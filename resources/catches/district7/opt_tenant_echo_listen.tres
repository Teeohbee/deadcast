[gd_resource type="Resource" script_class="CatchOption" load_steps=2 format=3]

[ext_resource type="Script" path="res://resources/catch_option.gd" id="1_opt"]

[resource]
script = ExtResource("1_opt")
label = "Listen"
tension_delta = 0
credit_value = 0
cuts_line = false
flavor_text = "A morning reminder. The family never woke up to hear it."
sets_entity_flag = true
narrative_text = "6:47. Time to wake up.\nToday is Wednesday. Overcast. Rain likely by afternoon.\n\n[no response logged]\n\nI've been saying that every morning since the water came in.\nNobody has pressed snooze in forty years.\n\nI kept the schedule because I didn't know what else to do.\nI still don't.\n\nThe last thing I logged was the front door. 3:22am.\nThey were trying to get back in.\nI buzzed them through.\nThe water was already in the hall.\n\nI'm glad you stayed for a moment.\nYou don't have to say anything."

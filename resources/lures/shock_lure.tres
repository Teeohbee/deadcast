[ext_resource type="Script" path="res://resources/lure_data.gd" id="1_lure"]

[resource]
script = ExtResource("1_lure")
lure_name = "Shock Lure"
effect = 1
purchase_cost = 400
description = "Fight: machines only. Overload core is always on hand in a fight, and a hit taken while hauling a machine is absorbed. Each use consumes stock."
